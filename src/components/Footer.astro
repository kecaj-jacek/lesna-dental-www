---
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <img src="/logo.svg" alt="Leśna Dental" class="footer-logo" />
        <p>Nowoczesna stomatologia dla dzieci i dorosłych.</p>
        <div class="social-icons">
          <a href="#" aria-label="Facebook">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--primary-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <a href="#" aria-label="Instagram">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--primary-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
        </div>
      </div>
      
      <div class="footer-col">
        <h3>Kontakt</h3>
        <p class="icon-text">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          kontakt@lesnadental.pl
        </p>
        <p class="icon-text">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          rejestracja@lesnadental.pl
        </p>
      </div>
      
      <div class="footer-col">
        <h3>Adres</h3>
        <p class="icon-text">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>ul. Leśna 8 lok. A.03<br />05-230 Kobyłka</span>
        </p>
      </div>
      
      <div class="footer-col">
        <h3>Godziny Otwarcia</h3>
        <p>Pon - Pt: 8:00 - 20:00<br />Sobota: 9:00 - 14:00</p>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Leśna Dental. Wszelkie prawa zastrzeżone.</p>
      <div class="footer-links">
        <a href="/polityka-prywatnosci">Polityka prywatności (RODO)</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--bg-darker);
    padding: 60px 0 20px;
    border-top: 1px solid var(--border-gray);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    margin-bottom: 40px;
  }
  .footer-logo {
    height: 50px;
    margin-bottom: 15px;
  }
  .footer-col h3 {
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--primary-gold);
    margin-bottom: 15px;
  }
  .footer-col p {
    color: var(--text-gray);
    line-height: 1.6;
    margin-bottom: 10px;
    font-size: 0.9rem;
  }
  .footer-col ul li a {
    color: var(--text-gray);
    transition: color 0.3s;
  }
  .footer-col ul li a:hover {
    color: var(--primary-gold);
  }
  .icon-text {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 12px;
  }
  .icon-text svg {
    margin-top: 4px;
    flex-shrink: 0;
  }
  .social-icons {
    display: flex;
    gap: 15px;
    margin-top: 20px;
  }
  .social-icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-gray);
    border-radius: 50%;
    transition: all 0.3s;
  }
  .social-icons a:hover {
    border-color: var(--primary-gold);
    background-color: rgba(176, 141, 87, 0.1);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
    border-top: 1px solid var(--border-gray);
    font-size: 0.8rem;
    color: var(--text-gray);
    flex-wrap: wrap;
    gap: 15px;
  }
  .footer-links a {
    margin-left: 20px;
  }
</style>
