---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
import PageHeader from '../components/PageHeader.astro';

const address = "ul. Leśna 8 lok. A.03, 05-230 Kobyłka";
const mapsUrl = "https://maps.app.goo.gl/S4teyCzJ9hKTmmxb6";
---
<Layout title="Kontakt" description="Skontaktuj się z gabinetem Leśna Dental w Kobyłce – adres, telefon, e-mail oraz formularz umawiania wizyt.">
  <Header />

  <PageHeader
    title="Kontakt"
    eyebrow="Skontaktuj się z nami"
    subtitle="Masz pytania albo chcesz umówić wizytę? Jesteśmy do dyspozycji."
  />

  <main class="page-container">
    <div class="container contact-grid">
      <div class="contact-info fade-in">
        <div class="info-item">
          <div class="info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <div>
            <h3>Adres</h3>
            <p><a href={mapsUrl} target="_blank" rel="noopener noreferrer">{address}</a></p>
          </div>
        </div>

        <div class="info-item">
          <div class="info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13 1 .36 1.98.69 2.93a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.15-1.15a2 2 0 0 1 2.11-.45c.95.33 1.93.56 2.93.69A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div>
            <h3>Telefon</h3>
            <p><a href="tel:+48576979469">576 979 469</a></p>
          </div>
        </div>

        <div class="info-item">
          <div class="info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <div>
            <h3>E-mail</h3>
            <p><a href="mailto:kontakt@lesnadental.pl">kontakt@lesnadental.pl</a></p>
          </div>
        </div>

        <div class="info-item">
          <div class="info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div>
            <h3>Umów wizytę</h3>
            <p>Aby umówić wizytę, prosimy o przesłanie formularza z preferowaną datą i wyborem odpowiedniego celu wizyty.</p>
          </div>
        </div>

        <a href="#umow-wizyte" class="btn btn-filled contact-cta">Umów wizytę</a>
      </div>

      <div class="map-embed fade-in">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2437.911033911512!2d21.21426107731223!3d52.33576004985301!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471edb4f15f97f71%3A0x52fc46c6e7ba6e1c!2sLe%C5%9Bna%20Dental%20Stomatologia%20i%20Tomografia%20CBCT!5e0!3m2!1spl!2spl!4v1788781760948!5m2!1spl!2spl"
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="Mapa dojazdu - Leśna Dental"
        ></iframe>
      </div>
    </div>
  </main>

  <Footer />
  <StickyCTA />
</Layout>
<style>
  .page-container {
    padding: 90px 0 100px;
  }
  .contact-grid {
    display: flex;
    gap: 60px;
    align-items: stretch;
  }
  .contact-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 35px;
  }
  .info-item {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .info-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--bg-card);
    border: 1px solid var(--border-gray);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .info-item h3 {
    font-size: 1.05rem;
    color: var(--text-light);
    margin-bottom: 6px;
  }
  .info-item p {
    color: var(--text-gray);
    line-height: 1.6;
  }
  .info-item a {
    color: var(--text-gray);
    transition: color 0.3s;
  }
  .info-item a:hover {
    color: var(--primary-gold);
  }
  .contact-cta {
    align-self: flex-start;
    margin-top: 10px;
  }

  .map-embed {
    flex: 1;
    min-height: 420px;
    border: 1px solid var(--border-gray);
    border-radius: 8px;
    overflow: hidden;
  }
  .map-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 420px;
  }

  @media (max-width: 900px) {
    .contact-grid {
      flex-direction: column;
    }
    .map-embed {
      min-height: 300px;
    }
    .map-embed iframe {
      min-height: 300px;
    }
  }
</style>
