---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Strona nie znaleziona" description="Strona, której szukasz, nie istnieje lub została przeniesiona. Wróć na stronę główną Leśna Dental.">
  <Header />

  <main class="not-found">
    <div class="container">
      <p class="not-found-code">404</p>
      <h1>Nie znaleziono strony</h1>
      <p class="not-found-text">Strona, której szukasz, nie istnieje lub została przeniesiona.</p>
      <a href="/" class="btn btn-filled">Wróć na stronę główną</a>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 20px 100px;
  }
  .not-found-code {
    font-size: 5rem;
    font-weight: 700;
    color: var(--primary-gold);
    line-height: 1;
    margin-bottom: 10px;
  }
  .not-found-text {
    color: var(--text-gray);
    margin-bottom: 30px;
  }
</style>
